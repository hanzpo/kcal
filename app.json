{
  "expo": {
    "name": "OpenMacro",
    "slug": "openmacro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "openmacro",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.hanzpo.openmacro",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F4F1",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F4F1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 84,
          "dark": {
            "backgroundColor": "#0D0D0D"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "OpenMacro uses the camera to scan food barcodes and photograph meals for AI logging."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "OpenMacro reads your weight from Health so smart-scale weigh-ins count toward your trend.",
          "NSHealthUpdateUsageDescription": "OpenMacro writes manual weigh-ins to Health so all your apps share one record.",
          "background": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fc6ba2fc-3fb3-4138-b1d7-09c2f4c26c8f"
      }
    },
    "owner": "hanzpo"
  }
}
