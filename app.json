{
  "expo": {
    "name": "Kcal",
    "slug": "kcal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kcal",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.hanzpo.kcal",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 84,
          "dark": {
            "backgroundColor": "#0E0E0D"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Kcal uses the camera to scan food barcodes and photograph meals for AI logging."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Kcal reads your weight from Health so smart-scale weigh-ins count toward your trend.",
          "NSHealthUpdateUsageDescription": "Kcal writes manual weigh-ins to Health so all your apps share one record.",
          "background": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "anthropicApiKey": {},
      "eas": {
        "projectId": "124663b9-0a73-4486-b7a6-f08fc2fd6df5"
      }
    },
    "owner": "hanzpo"
  }
}
